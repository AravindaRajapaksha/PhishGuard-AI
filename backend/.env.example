# PhishGuard AI Backend Environment Configuration

APP_NAME="PhishGuard AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Database Connection String
# For local zero-config development on Windows 11, leave as SQLite or point to PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/phishguard_ai"
DATABASE_URL="sqlite:///./phishguard.db"

# Allowed Frontend CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Active Versioned ML Artifact Directory
MODEL_VERSION="v1"

# Public Scan Endpoint Rate Limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30
